# Copy to .env.local and fill in actual values: cp .env.example .env.local
# NEVER commit .env.local — the values here are placeholders only.
# Every variable must ALSO be added to Vercel (Production/Preview/Development).

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (triggered 1-to-1 only) ---
RESEND_API_KEY=

# --- Email (broadcasts only) ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=MLA

# --- Cloudflare R2 backup (nightly copy of Supabase Storage) ---
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=mla-backups
CLOUDFLARE_R2_ENDPOINT=

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://mla.org.ng
CRON_SECRET=
SUPER_ADMIN_SEED_EMAIL=

# --- Payments (test keys first, live after Phase 5 passes) ---
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# --- License key HMAC signing ---
LICENSE_KEY_SECRET=

# --- DB access for local migrations/scripts only (never in app runtime) ---
# POSTGRES_URL=
# POSTGRES_URL_NON_POOLING=