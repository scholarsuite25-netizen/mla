# ============================================================
# Mentorship & Leadership Academy (MLA) - Environment Variables
# Copy to .env.local and fill in actual values: cp .env.example .env.local
# NEVER commit .env.local — the values here are placeholders only.
# Every variable must ALSO be added to Vercel (Production/Preview/Development).
# ============================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Email (1-to-1 Triggered via Resend) ---
RESEND_API_KEY=re_your_api_key
TRANSACTIONAL_EMAIL_FROM=MLA <enquiries@mla.org.ng>

# --- Email (Broadcasts & Newsletters via Brevo) ---
BREVO_API_KEY=xkeysib-your_brevo_api_key
BREVO_SENDER_EMAIL=enquiries@mla.org.ng
BREVO_SENDER_NAME=MLA Academy

# --- Cloudflare R2 Backups (Nightly Storage Backup) ---
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET=mla-backups
CLOUDFLARE_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# --- Site URL & Super Admin Seed ---
NEXT_PUBLIC_SITE_URL=https://mla.org.ng
SUPER_ADMIN_SEED_EMAIL=superadmin@mla.org.ng

# --- Payments (Paystack Live/Test Gateway) ---
PAYSTACK_SECRET_KEY=sk_live_your_secret_key
PAYSTACK_PUBLIC_KEY=pk_live_your_public_key
NEXT_PUBLIC_PAYSTACK_KEY=pk_live_your_public_key

# --- License Key Cryptographic HMAC Signing ---
LICENSE_KEY_SECRET=your_32_byte_random_secret_string

# --- Database Direct Access for Migrations/Scripts ---
# POSTGRES_URL=postgres://...
# POSTGRES_URL_NON_POOLING=postgres://...

# --- Vercel Cron Security ---
CRON_SECRET=your_cron_secret_token